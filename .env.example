# The crew backend. Leave all three unset and the app runs exactly as it does
# offline: solo, no sharing, no network. Nothing degrades — that is the mode it
# was built in.
#
# To turn it on:
#   1. Make a project at supabase.com (the free tier is plenty).
#   2. Run supabase/schema.sql in its SQL editor.
#   3. Copy the values below from Project settings → API.
#
# SUPABASE_SERVICE_KEY bypasses row-level security, so it is server-only and
# must never be prefixed NEXT_PUBLIC_. It is read solely by lib/server/db.ts.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# The one flag the browser sees: whether to show any crew UI at all.
NEXT_PUBLIC_CREW_ENABLED=1

# The AI-assisted scheduling proxy, unrelated to the crew (app/api/generate).
# REPLICATE_API_TOKEN=
